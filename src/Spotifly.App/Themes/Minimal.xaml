<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MINIMAL THEME: Clean, dark neutral surface, simple crisp borders, no glow -->
    <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#EE121212" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="IslandForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="IslandSecondaryForegroundBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="IslandAccentBrush" Color="#1DB954" />
    <SolidColorBrush x:Key="IslandButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="IslandButtonPressedBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="IslandCardBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="IslandCardBorderBrush" Color="#2E2E2E" />

    <!-- Window Background & Controls for Settings / Dialogs -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#141414" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#222222" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3C3C3C" />

    <!-- Progress Arc Theme Resources -->
    <SolidColorBrush x:Key="ProgressArcTrackBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ProgressArcForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ProgressArcGlowBrush" Color="Transparent" />

    <!-- DropShadow Effect for Island in Minimal Theme (pure shadow, zero glow) -->
    <DropShadowEffect x:Key="IslandShadowEffect"
                      BlurRadius="14"
                      Color="#000000"
                      Opacity="0.55"
                      ShadowDepth="4"
                      Direction="270" />

</ResourceDictionary>
