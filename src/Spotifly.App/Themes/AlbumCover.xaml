<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default palette used until the active album artwork supplies its own accent. -->
    <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#F2121614" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#961ED760" />
    <SolidColorBrush x:Key="IslandForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="IslandSecondaryForegroundBrush" Color="#C8D7D7D7" />
    <SolidColorBrush x:Key="IslandAccentBrush" Color="#1ED760" />
    <SolidColorBrush x:Key="IslandButtonHoverBrush" Color="#361ED760" />
    <SolidColorBrush x:Key="IslandButtonPressedBrush" Color="#521ED760" />
    <SolidColorBrush x:Key="IslandCardBackgroundBrush" Color="#EB171B19" />
    <SolidColorBrush x:Key="IslandCardBorderBrush" Color="#401ED760" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#141414" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#222222" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#5A1ED760" />
    <SolidColorBrush x:Key="ProgressArcTrackBrush" Color="#2C1ED760" />
    <SolidColorBrush x:Key="ProgressArcForegroundBrush" Color="#1ED760" />
    <SolidColorBrush x:Key="ProgressArcGlowBrush" Color="#701ED760" />
    <DropShadowEffect x:Key="IslandShadowEffect"
                      BlurRadius="18"
                      Color="#1ED760"
                      Opacity="0.55"
                      ShadowDepth="2"
                      Direction="270" />
</ResourceDictionary>
