<Window x:Class="Spotifly.App.Views.IslandView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Spotifly Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Grid x:Name="RootLayout" Background="Transparent" SnapsToDevicePixels="True">
        <!-- Visual Island Container hosting the Vector Semicircle/Dome Path and Content -->
        <Grid x:Name="IslandContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              ClipToBounds="False"
              Effect="{DynamicResource IslandShadowEffect}">

            <!-- Vector Path for the Semicircular / Domed Island Shape -->
            <!-- Flat top edge flush against the screen top; smooth curved bottom -->
            <Path x:Name="IslandBackgroundPath"
                  Fill="{DynamicResource IslandBackgroundBrush}"
                  Stroke="{DynamicResource IslandBorderBrush}"
                  StrokeThickness="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

            <!-- Island Inner Content Container clipped to the exact Vector Geometry -->
            <Grid x:Name="IslandContentContainer"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <!-- COMPACT VIEW: Exactly 3 items (Gear, Spotifly middle pill, Close X) -->
                <!-- Positioned comfortably in the upper-middle area of the dome -->
                <Grid x:Name="CompactView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Height="46"
                      Margin="16,3,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. Settings (Gear vector icon) -->
                    <Button x:Name="SettingsButton"
                            Grid.Column="0"
                            Width="32" Height="32"
                            ToolTip="Spotifly Settings"
                            Style="{DynamicResource IslandCircleButtonStyle}"
                            Click="SettingsButton_Click">
                        <!-- Gear Vector Path -->
                        <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.44,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.73,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58C4.83,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.25,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94z M12,15.5c-1.93,0 -3.5,-1.57 -3.5,-3.5s1.57,-3.5 3.5,-3.5s3.5,1.57 3.5,3.5S13.93,15.5 12,15.5z" />
                    </Button>

                    <!-- 2. Spotifly / Spotify Entry (Middle) -->
                    <Button x:Name="HomeEntryButton"
                            Grid.Column="1"
                            Height="32"
                            Margin="4,0,4,0"
                            ToolTip="Spotifly Home / Now Playing"
                            Style="{DynamicResource IslandCircleButtonStyle}"
                            Click="HomeEntryButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Spotify/Spotifly Sound Waves Vector Icon -->
                            <Path Fill="{DynamicResource IslandAccentBrush}"
                                  Width="15" Height="15"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.59,16.43C16.41,16.72 16.03,16.81 15.74,16.63C13.39,15.2 10.43,14.88 6.95,15.67C6.62,15.75 6.29,15.54 6.21,15.21C6.13,14.88 6.34,14.55 6.67,14.47C10.48,13.6 13.75,13.96 16.39,15.58C16.68,15.76 16.77,16.14 16.59,16.43M17.81,13.71C17.58,14.08 17.1,14.2 16.73,13.97C14.04,12.32 9.94,11.84 6.76,12.81C6.35,12.93 5.91,12.7 5.79,12.29C5.67,11.88 5.9,11.44 6.31,11.32C9.94,10.22 14.47,10.75 17.55,12.65C17.92,12.88 18.04,13.36 17.81,13.71M17.92,10.88C14.69,8.95 9.38,8.78 6.3,9.71C5.81,9.86 5.29,9.58 5.14,9.09C4.99,8.6 5.27,8.08 5.76,7.93C9.3,6.86 15.17,7.07 18.88,9.28C19.32,9.54 19.46,10.11 19.2,10.55C18.94,11 18.36,11.14 17.92,10.88Z" />
                            <TextBlock Text="Spotifly"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 3. Close / Dismiss (X vector icon) -->
                    <Button x:Name="DismissButton"
                            Grid.Column="2"
                            Width="32" Height="32"
                            ToolTip="Dismiss Island (Esc)"
                            Style="{DynamicResource IslandCircleButtonStyle}"
                            Click="DismissButton_Click">
                        <!-- X Vector Path -->
                        <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                    </Button>
                </Grid>

                <!-- EXPANDED VIEW: Container for Now Playing / Library -->
                <!-- Positioned within the semicircular dome curve with ergonomic side and bottom margins -->
                <Grid x:Name="ExpandedView"
                      Visibility="Collapsed"
                      Opacity="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="36,12,36,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header bar in expanded view: view label & collapse action -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="ExpandedTitleText"
                                   Text="Now Playing"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="24" Height="24"
                                    ToolTip="Settings"
                                    Style="{DynamicResource IslandCircleButtonStyle}"
                                    Click="SettingsButton_Click">
                                <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.44,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.73,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58C4.83,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.25,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94z M12,15.5c-1.93,0 -3.5,-1.57 -3.5,-3.5s1.57,-3.5 3.5,-3.5s3.5,1.57 3.5,3.5S13.93,15.5 12,15.5z" />
                            </Button>
                            <Button Width="24" Height="24"
                                    Margin="4,0,0,0"
                                    ToolTip="Dismiss Island"
                                    Style="{DynamicResource IslandCircleButtonStyle}"
                                    Click="DismissButton_Click">
                                <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Expanded Body Area (Placeholder for Phase 7-10 Controls) -->
                    <!-- Contained nicely in the lower portion of the dome -->
                    <Border Grid.Row="1"
                            Background="#18FFFFFF"
                            CornerRadius="18"
                            Padding="12"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Spotifly Expanded View"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Ready for Now Playing / Library controls"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
