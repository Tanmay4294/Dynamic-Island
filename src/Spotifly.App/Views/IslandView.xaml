<Window x:Class="Spotifly.App.Views.IslandView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Spotifly.App.Controls"
        mc:Ignorable="d"
        Title="Spotifly Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Grid x:Name="RootLayout" Background="Transparent" SnapsToDevicePixels="True">
        <!-- Visual Island Container hosting the Vector Semicircle/Dome Path and Content -->
        <Grid x:Name="IslandContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              ClipToBounds="False"
              Effect="{DynamicResource IslandShadowEffect}">

            <!-- Vector Path for the Semicircular / Domed Island Shape -->
            <!-- Flat top edge flush against the screen top; smooth curved bottom -->
            <Path x:Name="IslandBackgroundPath"
                  Fill="{DynamicResource IslandBackgroundBrush}"
                  Stroke="{DynamicResource IslandBorderBrush}"
                  StrokeThickness="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

            <!-- Semicircular Curved Progress Arc (Phase 5) contouring the lower dome border -->
            <controls:SemicircleProgressControl x:Name="IslandProgressArc"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                StrokeThickness="2.5"
                                                Inset="1.5"
                                                TrackBrush="{DynamicResource ProgressArcTrackBrush}"
                                                ProgressBrush="{DynamicResource ProgressArcForegroundBrush}"
                                                GlowBrush="{DynamicResource ProgressArcGlowBrush}"
                                                IsCompact="True"
                                                IsHitTestVisible="False" />

            <!-- Island Inner Content Container clipped to the exact Vector Geometry -->
            <Grid x:Name="IslandContentContainer"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <!-- COMPACT VIEW: Exactly 3 items (Gear, Spotifly middle pill, Close X) -->
                <!-- Positioned comfortably in the upper-middle area of the dome -->
                <Grid x:Name="CompactView"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Height="38"
                      Width="110"
                      Margin="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. Settings (Gear vector icon) -->
                    <Button x:Name="SettingsButton"
                            Visibility="Collapsed"
                            Grid.Column="0"
                            Width="22" Height="22"
                            ToolTip="Spotifly Settings"
                            AutomationProperties.Name="Spotifly Settings"
                            Style="{DynamicResource IslandCircleButtonStyle}"
                            Click="SettingsButton_Click">
                        <!-- Gear Vector Path -->
                        <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.44,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.73,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58C4.83,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.25,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94z M12,15.5c-1.93,0 -3.5,-1.57 -3.5,-3.5s1.57,-3.5 3.5,-3.5s3.5,1.57 3.5,3.5S13.93,15.5 12,15.5z" />
                    </Button>

                    <!-- 2. Spotifly / Spotify Entry (Middle) -->
                    <Button x:Name="HomeEntryButton"
                            Grid.Column="1"
                            Height="32"
                            Margin="4,0,4,0"
                            ToolTip="Spotifly Home / Now Playing"
                            AutomationProperties.Name="Spotifly Home and Now Playing"
                            Style="{DynamicResource IslandCircleButtonStyle}"
                            Click="HomeEntryButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Spotify/Spotifly Sound Waves Vector Icon -->
                            <Path Fill="{DynamicResource IslandAccentBrush}"
                                  Width="15" Height="15"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.59,16.43C16.41,16.72 16.03,16.81 15.74,16.63C13.39,15.2 10.43,14.88 6.95,15.67C6.62,15.75 6.29,15.54 6.21,15.21C6.13,14.88 6.34,14.55 6.67,14.47C10.48,13.6 13.75,13.96 16.39,15.58C16.68,15.76 16.77,16.14 16.59,16.43M17.81,13.71C17.58,14.08 17.1,14.2 16.73,13.97C14.04,12.32 9.94,11.84 6.76,12.81C6.35,12.93 5.91,12.7 5.79,12.29C5.67,11.88 5.9,11.44 6.31,11.32C9.94,10.22 14.47,10.75 17.55,12.65C17.92,12.88 18.04,13.36 17.81,13.71M17.92,10.88C14.69,8.95 9.38,8.78 6.3,9.71C5.81,9.86 5.29,9.58 5.14,9.09C4.99,8.6 5.27,8.08 5.76,7.93C9.3,6.86 15.17,7.07 18.88,9.28C19.32,9.54 19.46,10.11 19.2,10.55C18.94,11 18.36,11.14 17.92,10.88Z" />
                        </StackPanel>
                    </Button>

                    <!-- 3. Close / Dismiss (X vector icon) -->
                    <Button x:Name="DismissButton"
                            Visibility="Collapsed"
                            Grid.Column="2"
                            Width="22" Height="22"
                            ToolTip="Dismiss Island (Esc)"
                            AutomationProperties.Name="Dismiss Island"
                            Style="{DynamicResource IslandCircleButtonStyle}"
                            Click="DismissButton_Click">
                        <!-- X Vector Path -->
                        <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                    </Button>
                </Grid>

                <!-- EXPANDED VIEW: Container for Now Playing / Library -->
                <!-- Positioned within the semicircular dome curve with ergonomic side and bottom margins -->
                <Grid x:Name="ExpandedView"
                      Visibility="Collapsed"
                      Opacity="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="36,0,36,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header bar in expanded view: view label & navigation indicator & actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="ExpandedTitleText"
                                       Text="Now Playing"
                                       Visibility="Collapsed"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       VerticalAlignment="Center" />

                            <!-- View Indicator / Wheel Hint (Phase 11) -->
                            <Border x:Name="NavigationHintBadge"
                                    Visibility="Collapsed"
                                    Margin="8,0,0,0"
                                    Padding="5,1"
                                    CornerRadius="4"
                                    Background="#14FFFFFF"
                                    ToolTip="Scroll wheel or touchpad up/down to switch between Now Playing &amp; Playlists"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="NavigationHintIcon"
                                          Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                          Width="8" Height="8"
                                          Stretch="Uniform"
                                          Margin="0,0,3,0"
                                          Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z" />
                                    <TextBlock x:Name="NavigationHintText"
                                               Text="Scroll for Playlists"
                                               FontSize="9"
                                               Foreground="{DynamicResource IslandSecondaryForegroundBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Toggle Library / Now Playing Button -->
                            <Button x:Name="LibraryToggleButton"
                                    Width="24" Height="24"
                                    ToolTip="Your Playlists"
                                    AutomationProperties.Name="Toggle Playlists and Now Playing"
                                    Style="{DynamicResource IslandCircleButtonStyle}"
                                    Click="LibraryToggleButton_Click">
                                <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Data="M4,6H2V20A2,2 0 0,0 4,22H18V20H4M20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H8V4H20M10,9V11H18V9M10,6V8H18V6M10,12V14H15V12" />
                            </Button>
                            <Button Width="24" Height="24"
                                    Margin="4,0,0,0"
                                    ToolTip="Settings"
                                    AutomationProperties.Name="Open Settings"
                                    Style="{DynamicResource IslandCircleButtonStyle}"
                                    Click="SettingsButton_Click">
                                <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.44,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.73,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58C4.83,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.25,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94z M12,15.5c-1.93,0 -3.5,-1.57 -3.5,-3.5s1.57,-3.5 3.5,-3.5s3.5,1.57 3.5,3.5S13.93,15.5 12,15.5z" />
                            </Button>
                            <Button Width="24" Height="24"
                                    Margin="4,0,0,0"
                                    ToolTip="Dismiss Island"
                                    AutomationProperties.Name="Dismiss Expanded Island"
                                    Style="{DynamicResource IslandCircleButtonStyle}"
                                    Click="DismissButton_Click">
                                <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Expanded Body Area: Spotify Now Playing (Phase 7) or Playlists Library (Phase 8) -->
                    <!-- Contained ergonomically inside the lower portion of the semicircular dome -->
                    <Grid Grid.Row="1">
                        <!-- 1. Now Playing Body Panel -->
                        <Border x:Name="NowPlayingPanel"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="72" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <!-- Album Artwork Column -->
                                    <ColumnDefinition Width="68" />
                                    <!-- Track Info & Playback Controls Column -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Artwork with rounded corners and missing-artwork fallback -->
                                <Border Grid.Column="0"
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Width="62" Height="62"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,-16,0,0"
                                        CornerRadius="10"
                                        ClipToBounds="True"
                                        Background="#262626"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="Open in Spotify"
                                        MouseLeftButtonUp="Artwork_MouseLeftButtonUp">
                                    <Grid>
                                        <!-- Fallback Music Note / Disc vector when artwork is missing or loading -->
                                        <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                              Width="24" Height="24"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stretch="Uniform"
                                              Data="M12,3V13.55C11.41,13.21 10.73,13 10,13C7.79,13 6,14.79 6,17C6,19.21 7.79,21 10,21C12.21,21 14,19.21 14,17V7H18V3H12Z" />
                                        <!-- Dynamic Album Artwork Image -->
                                        <Image x:Name="AlbumArtworkImage"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <!-- Track details, Spotify badge, and Media Playback Controls -->
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,-8,0,2" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Track Title + Clickable Spotify Logo Attribution -->
                                    <Grid Grid.Row="0">
                                        <TextBlock x:Name="TrackTitleText"
                                                   Text="No Track Playing"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource IslandForegroundBrush}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   Margin="0" />

                                        <!-- Spotify Brand Attribution Icon (Open track in Spotify) -->
                                        <Button x:Name="OpenInSpotifyButton"
                                                Width="18" Height="18"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                ToolTip="Open track in Spotify"
                                                Style="{DynamicResource IslandCircleButtonStyle}"
                                                Click="OpenInSpotifyButton_Click">
                                            <Path Fill="{DynamicResource IslandAccentBrush}"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"
                                                  Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.59,16.43C16.41,16.72 16.03,16.81 15.74,16.63C13.39,15.2 10.43,14.88 6.95,15.67C6.62,15.75 6.29,15.54 6.21,15.21C6.13,14.88 6.34,14.55 6.67,14.47C10.48,13.6 13.75,13.96 16.39,15.58C16.68,15.76 16.77,16.14 16.59,16.43M17.81,13.71C17.58,14.08 17.1,14.2 16.73,13.97C14.04,12.32 9.94,11.84 6.76,12.81C6.35,12.93 5.91,12.7 5.79,12.29C5.67,11.88 5.9,11.44 6.31,11.32C9.94,10.22 14.47,10.75 17.55,12.65C17.92,12.88 18.04,13.36 17.81,13.71M17.92,10.88C14.69,8.95 9.38,8.78 6.3,9.71C5.81,9.86 5.29,9.58 5.14,9.09C4.99,8.6 5.27,8.08 5.76,7.93C9.3,6.86 15.17,7.07 18.88,9.28C19.32,9.54 19.46,10.11 19.2,10.55C18.94,11 18.36,11.14 17.92,10.88Z" />
                                        </Button>
                                    </Grid>

                                    <!-- Row 1: Artist & Album -->
                                    <TextBlock x:Name="TrackArtistText"
                                               Grid.Row="1"
                                               Text="Spotify is idle"
                                               FontSize="11"
                                               Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Margin="0,2,0,6" />

                                    <!-- Row 2: Media Playback Transport Controls -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Previous Track Button -->
                                        <Button x:Name="PreviousTrackButton"
                                                Width="28" Height="28"
                                                ToolTip="Previous Track"
                                                AutomationProperties.Name="Previous Track"
                                                Style="{DynamicResource IslandCircleButtonStyle}"
                                                Click="PreviousTrackButton_Click">
                                            <Path Fill="{DynamicResource IslandForegroundBrush}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Data="M6,6H8V18H6M9.5,12L18,18V6L9.5,12Z" />
                                        </Button>

                                        <!-- Play / Pause Button -->
                                        <Button x:Name="PlayPauseButton"
                                                Width="32" Height="32"
                                                Margin="8,0,8,0"
                                                ToolTip="Play / Pause"
                                                AutomationProperties.Name="Play or Pause"
                                                Background="{DynamicResource IslandAccentBrush}"
                                                Style="{DynamicResource IslandCircleButtonStyle}"
                                                Click="PlayPauseButton_Click">
                                                  <Path x:Name="PlayPauseIconPath"
                                                  Fill="#FFFFFFFF"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z" />
                                        </Button>

                                        <!-- Next Track Button -->
                                        <Button x:Name="NextTrackButton"
                                                Width="28" Height="28"
                                                ToolTip="Next Track"
                                                AutomationProperties.Name="Next Track"
                                                Style="{DynamicResource IslandCircleButtonStyle}"
                                                Click="NextTrackButton_Click">
                                            <Path Fill="{DynamicResource IslandForegroundBrush}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Data="M16,18H18V6H16M6,6L14.5,12L6,18V6Z" />
                                        </Button>

                                        <!-- Status / Device indicator -->
                                        <TextBlock x:Name="PlaybackDeviceText"
                                                   Visibility="Collapsed"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="85" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2. Playlists Library Panel (Phase 8) -->
                        <Border x:Name="PlaylistsLibraryPanel"
                                Visibility="Collapsed"
                                Background="#18FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="8,6"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Library Sub-header with Refresh action and count -->
                                <Grid Grid.Row="0" Margin="4,0,4,6">
                                    <TextBlock x:Name="PlaylistCountText"
                                               Text="Your Playlists"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                               VerticalAlignment="Center" />

                                    <Button x:Name="RefreshPlaylistsButton"
                                            Width="22" Height="22"
                                            HorizontalAlignment="Right"
                                            ToolTip="Refresh Playlists"
                                            AutomationProperties.Name="Refresh Playlists"
                                            Style="{DynamicResource IslandCircleButtonStyle}"
                                            Click="RefreshPlaylistsButton_Click">
                                        <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                                    </Button>
                                </Grid>

                                <!-- Loading / Empty / Disconnected message overlay -->
                                <TextBlock x:Name="PlaylistsStatusText"
                                           Grid.Row="1"
                                           Text="Loading your playlists..."
                                           FontSize="12"
                                           Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />

                                <!-- Scrollable Playlist Rows Collection -->
                                <ScrollViewer x:Name="PlaylistsScrollViewer"
                                              Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                    <ItemsControl x:Name="PlaylistsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,2,2,4"
                                                        Padding="6,4"
                                                        CornerRadius="8"
                                                        Background="#12FFFFFF"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="PlaylistItem_MouseLeftButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource IslandButtonHoverBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Cover Thumbnail -->
                                                            <ColumnDefinition Width="34" />
                                                            <!-- Name and Track Count -->
                                                            <ColumnDefinition Width="*" />
                                                            <!-- Open in Spotify Icon -->
                                                            <ColumnDefinition Width="24" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Playlist Cover Thumbnail -->
                                                        <Border Grid.Column="0"
                                                                Width="30" Height="30"
                                                                CornerRadius="4"
                                                                ClipToBounds="True"
                                                                Background="#282828">
                                                            <Grid>
                                                                <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                                                      Width="14" Height="14"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Stretch="Uniform"
                                                                      Data="M15,6H3V8H15V6M15,10H3V12H15V10M3,16H11V14H3V16M17,6V14.18C16.69,14.07 16.35,14 16,14A3,3 0 0,0 13,17A3,3 0 0,0 16,20A3,3 0 0,0 19,17V8H22V6H17Z" />
                                                                <Image Source="{Binding CoverImageUrl}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- Name & Details -->
                                                        <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}" />
                                                            <TextBlock Text="{Binding TotalTracks, StringFormat='{}{0} tracks'}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}" />
                                                        </StackPanel>

                                                        <!-- Open in Spotify Action Button -->
                                                        <Button Grid.Column="2"
                                                                Width="20" Height="20"
                                                                ToolTip="Open in Spotify"
                                                                Style="{DynamicResource IslandCircleButtonStyle}"
                                                                Click="OpenPlaylistInSpotify_Click"
                                                                Tag="{Binding}">
                                                            <Path Fill="{DynamicResource IslandAccentBrush}"
                                                                  Width="12" Height="12"
                                                                  Stretch="Uniform"
                                                                  Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.59,16.43C16.41,16.72 16.03,16.81 15.74,16.63C13.39,15.2 10.43,14.88 6.95,15.67C6.62,15.75 6.29,15.54 6.21,15.21C6.13,14.88 6.34,14.55 6.67,14.47C10.48,13.6 13.75,13.96 16.39,15.58C16.68,15.76 16.77,16.14 16.59,16.43M17.81,13.71C17.58,14.08 17.1,14.2 16.73,13.97C14.04,12.32 9.94,11.84 6.76,12.81C6.35,12.93 5.91,12.7 5.79,12.29C5.67,11.88 5.9,11.44 6.31,11.32C9.94,10.22 14.47,10.75 17.55,12.65C17.92,12.88 18.04,13.36 17.81,13.71M17.92,10.88C14.69,8.95 9.38,8.78 6.3,9.71C5.81,9.86 5.29,9.58 5.14,9.09C4.99,8.6 5.27,8.08 5.76,7.93C9.3,6.86 15.17,7.07 18.88,9.28C19.32,9.54 19.46,10.11 19.2,10.55C18.94,11 18.36,11.14 17.92,10.88Z" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- 3. Playlist Song List Panel (Phase 9) -->
                        <Border x:Name="PlaylistTracksPanel"
                                Visibility="Collapsed"
                                Background="#18FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="8,6"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Song List Sub-header with Back Button and Active Playlist Title -->
                                <Grid Grid.Row="0" Margin="2,0,4,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Back to Playlists Button -->
                                        <Button x:Name="BackToPlaylistsButton"
                                                Width="22" Height="22"
                                                Margin="0,0,6,0"
                                                ToolTip="Back to Playlists"
                                                AutomationProperties.Name="Back to Playlists"
                                                Style="{DynamicResource IslandCircleButtonStyle}"
                                                Click="BackToPlaylistsButton_Click">
                                            <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
                                        </Button>

                                        <TextBlock x:Name="ActivePlaylistNameText"
                                                   Text="Playlist Songs"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Refresh Tracks Button -->
                                    <Button x:Name="RefreshTracksButton"
                                            Width="22" Height="22"
                                            HorizontalAlignment="Right"
                                            ToolTip="Refresh Songs"
                                            AutomationProperties.Name="Refresh Songs"
                                            Style="{DynamicResource IslandCircleButtonStyle}"
                                            Click="RefreshTracksButton_Click">
                                        <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                                    </Button>
                                </Grid>

                                <!-- Playback Status Toast Notification Banner (Phase 10) -->
                                <Border x:Name="TracksToastBorder"
                                        Grid.Row="0"
                                        Background="#DD1A1A1A"
                                        BorderBrush="{DynamicResource IslandAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="2,0,2,4"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="TracksToastText"
                                               Text="Playback started."
                                               FontSize="11"
                                               Foreground="{DynamicResource IslandForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <!-- Loading / Empty / Disconnected message overlay -->
                                <StackPanel x:Name="TracksStatusContainer"
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="TracksStatusText"
                                               Text="Loading tracks..."
                                               FontSize="12"
                                               Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                    <Button x:Name="RetryTracksButton"
                                            Content="Retry"
                                            Margin="0,6,0,0"
                                            Padding="10,2"
                                            FontSize="10"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            Foreground="{DynamicResource IslandForegroundBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            Cursor="Hand"
                                            Click="RefreshTracksButton_Click" />
                                </StackPanel>

                                <!-- Scrollable Track Rows Collection -->
                                <ScrollViewer x:Name="TracksScrollViewer"
                                              Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                    <ItemsControl x:Name="TracksItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,2,2,4"
                                                        Padding="6,4"
                                                        CornerRadius="8"
                                                        Background="#12FFFFFF"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="TrackItem_MouseLeftButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource IslandButtonHoverBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Artwork Thumbnail -->
                                                            <ColumnDefinition Width="32" />
                                                            <!-- Track Name and Artist -->
                                                            <ColumnDefinition Width="*" />
                                                            <!-- Play Button / Duration -->
                                                            <ColumnDefinition Width="26" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Track Thumbnail with fallback -->
                                                        <Border Grid.Column="0"
                                                                Width="28" Height="28"
                                                                CornerRadius="4"
                                                                ClipToBounds="True"
                                                                Background="#282828">
                                                            <Grid>
                                                                <Path Fill="{DynamicResource IslandSecondaryForegroundBrush}"
                                                                      Width="12" Height="12"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Stretch="Uniform"
                                                                      Data="M12,3V13.55C11.41,13.21 10.73,13 10,13C7.79,13 6,14.79 6,17C6,19.21 7.79,21 10,21C12.21,21 14,19.21 14,17V7H18V3H12Z" />
                                                                <Image Source="{Binding ArtworkUrl}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- Song Title & Artist Name with CharacterEllipsis and Tooltip -->
                                                        <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}" />
                                                            <TextBlock Text="{Binding ArtistName}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding ArtistName}" />
                                                        </StackPanel>

                                                        <!-- Play Action Button -->
                                                        <Button Grid.Column="2"
                                                                Width="22" Height="22"
                                                                ToolTip="Play this song"
                                                                Style="{DynamicResource IslandCircleButtonStyle}"
                                                                Click="PlayTrackButton_Click"
                                                                Tag="{Binding}">
                                                            <Path Fill="{DynamicResource IslandAccentBrush}"
                                                                  Width="11" Height="11"
                                                                  Stretch="Uniform"
                                                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
