<Window x:Class="Spotifly.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotifly Settings"
        Height="400" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#181818"
        Foreground="#FFFFFF"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Spotifly Settings"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />
            <TextBlock Text="Settings dialog integration (Phase 4 placeholder)"
                       FontSize="12"
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />
            <Button Content="Close"
                    Width="100"
                    Height="32"
                    Cursor="Hand"
                    Background="#282828"
                    Foreground="#FFFFFF"
                    BorderThickness="1"
                    BorderBrush="#444444"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
