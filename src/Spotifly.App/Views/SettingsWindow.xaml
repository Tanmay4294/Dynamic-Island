<Window x:Class="Spotifly.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotifly Settings"
        Height="620" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource IslandForegroundBrush}"
        WindowStyle="SingleBorderWindow">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22,18,22,22">
            <StackPanel>
                
                <!-- HEADER -->
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Spotifly Waves Vector -->
                        <Path Fill="{DynamicResource IslandAccentBrush}"
                              Width="18" Height="18"
                              Margin="0,0,8,0"
                              Stretch="Uniform"
                              Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.59,16.43C16.41,16.72 16.03,16.81 15.74,16.63C13.39,15.2 10.43,14.88 6.95,15.67C6.62,15.75 6.29,15.54 6.21,15.21C6.13,14.88 6.34,14.55 6.67,14.47C10.48,13.6 13.75,13.96 16.39,15.58C16.68,15.76 16.77,16.14 16.59,16.43M17.81,13.71C17.58,14.08 17.1,14.2 16.73,13.97C14.04,12.32 9.94,11.84 6.76,12.81C6.35,12.93 5.91,12.7 5.79,12.29C5.67,11.88 5.9,11.44 6.31,11.32C9.94,10.22 14.47,10.75 17.55,12.65C17.92,12.88 18.04,13.36 17.81,13.71M17.92,10.88C14.69,8.95 9.38,8.78 6.3,9.71C5.81,9.86 5.29,9.58 5.14,9.09C4.99,8.6 5.27,8.08 5.76,7.93C9.3,6.86 15.17,7.07 18.88,9.28C19.32,9.54 19.46,10.11 19.2,10.55C18.94,11 18.36,11.14 17.92,10.88Z" />
                        <TextBlock Text="Spotifly Settings"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- SECTION 1: SPOTIFY ACCOUNT & CONNECTIVITY (PHASE 6) -->
                <TextBlock Text="SPOTIFY ACCOUNT"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                           Margin="0,0,0,8" />

                        <TextBlock FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                   Margin="0,0,0,8">
                            <Run Text="Redirect URI (must match your Spotify app settings): " />
                            <Run Text="{Binding SpotifyRedirectUri}" FontWeight="SemiBold" />
                        </TextBlock>

                <Border Background="{DynamicResource IslandCardBackgroundBrush}"
                        BorderBrush="{DynamicResource IslandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Status and Account Info -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status Indicator Dot -->
                                 <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF6B6B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpotifyConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource IslandAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SpotifyConnectionStatusText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource IslandForegroundBrush}" />
                            </StackPanel>

                            <TextBlock Text="{Binding SpotifyProfileText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Status Message / Feedback -->
                        <TextBlock Text="{Binding SpotifyStatusMessage}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Action Buttons -->
                        <Grid>
                            <!-- Connect / Reconnect Button -->
                            <Button
                                    Height="30" Width="130"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsAuthenticating}"
                                    Background="{DynamicResource IslandAccentBrush}"
                                    Foreground="#000000"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Click="ConnectSpotifyButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="Connect Spotify" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpotifyConnected}" Value="True">
                                                <Setter Property="Content" Value="Reconnect" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAuthenticating}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Content" Value="Authorizing..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Disconnect Button -->
                            <Button Content="Disconnect"
                                    Height="30" Width="100"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    Foreground="{DynamicResource IslandForegroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    IsEnabled="{Binding IsSpotifyConnected}"
                                    Click="DisconnectSpotifyButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: APPEARANCE -->
                <TextBlock Text="APPEARANCE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Minimal Card -->
                    <RadioButton Grid.Column="0"
                                 GroupName="ThemeGroup"
                                 IsChecked="{Binding IsMinimalSelected, Mode=TwoWay}"
                                 Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="CardBorder"
                                        Background="#121212"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="8,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- Mini Theme Preview Graphic -->
                                        <Border Width="65" Height="22"
                                                Background="#1E1E1E"
                                                BorderBrush="#44FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="0,0,11,11"
                                                Margin="0,0,0,8" />
                                        <TextBlock Text="Minimal"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                                        <Setter TargetName="CardBorder" Property="Background" Value="#221DB954" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Modern Card -->
                    <RadioButton Grid.Column="2"
                                 GroupName="ThemeGroup"
                                 IsChecked="{Binding IsModernSelected, Mode=TwoWay}"
                                 Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="CardBorder"
                                        Background="#0E1511"
                                        BorderBrush="#441DB954"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="8,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- Mini Theme Preview Graphic -->
                                        <Border Width="65" Height="22"
                                                Background="#16221A"
                                                BorderBrush="#1DB954"
                                                BorderThickness="1"
                                                CornerRadius="0,0,11,11"
                                                Margin="0,0,0,8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" Color="#1DB954" Opacity="0.5" ShadowDepth="1" Direction="270" />
                                            </Border.Effect>
                                        </Border>
                                        <TextBlock Text="Modern"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                                        <Setter TargetName="CardBorder" Property="Background" Value="#221DB954" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Glassmorphism Card -->
                    <RadioButton Grid.Column="4"
                                 GroupName="ThemeGroup"
                                 IsChecked="{Binding IsGlassmorphismSelected, Mode=TwoWay}"
                                 Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="CardBorder"
                                        Background="#181D26"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="8,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- Mini Theme Preview Graphic -->
                                        <Border Width="65" Height="22"
                                                BorderBrush="#88FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="0,0,11,11"
                                                Margin="0,0,0,8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#C0262C36" Offset="0" />
                                                    <GradientStop Color="#90141820" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="Glass"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                                        <Setter TargetName="CardBorder" Property="Background" Value="#221DB954" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>

                <!-- SECTION 2: BEHAVIOUR -->
                <TextBlock Text="BEHAVIOUR &amp; POSITION"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                           Margin="0,0,0,8" />

                <Border Background="{DynamicResource IslandCardBackgroundBrush}"
                        BorderBrush="{DynamicResource IslandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Hover Activation Delay Slider -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Activation Delay"
                                       FontSize="12"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActivationDelayMs, StringFormat='{}{0} ms'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="50" Maximum="1000" SmallChange="25" LargeChange="100"
                                Value="{Binding ActivationDelayMs, Mode=TwoWay}"
                                ToolTip="Delay in milliseconds before revealing the island on webcam hover."
                                Margin="0,0,0,14" />

                        <!-- Hide Delay Slider -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Hide Delay"
                                       FontSize="12"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HideDelayMs, StringFormat='{}{0} ms'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="200" Maximum="2000" SmallChange="50" LargeChange="100"
                                Value="{Binding HideDelayMs, Mode=TwoWay}"
                                ToolTip="Delay before hiding the island after moving pointer away."
                                Margin="0,0,0,14" />

                        <!-- Horizontal Offset Slider -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Horizontal Offset (X)"
                                       FontSize="12"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HorizontalOffset, StringFormat='{}{0:0} px'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="-200" Maximum="200" SmallChange="5" LargeChange="20"
                                Value="{Binding HorizontalOffset, Mode=TwoWay}"
                                ToolTip="Horizontal screen offset in pixels (for webcam alignment)."
                                Margin="0,0,0,14" />

                        <!-- Vertical Offset Slider -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Vertical Offset (Y)"
                                       FontSize="12"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VerticalOffset, StringFormat='{}{0:0} px'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="0" Maximum="80" SmallChange="2" LargeChange="10"
                                Value="{Binding VerticalOffset, Mode=TwoWay}"
                                ToolTip="Vertical offset down from the top edge." />
                    </StackPanel>
                </Border>

                <!-- SECTION 3: PROGRESS ARC SIMULATOR (PHASE 5 DEVELOPER TOOL) -->
                <TextBlock Text="PROGRESS ARC (SIMULATED)"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                           Margin="0,0,0,8" />

                <Border Background="{DynamicResource IslandCardBackgroundBrush}"
                        BorderBrush="{DynamicResource IslandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Auto simulation toggle -->
                        <CheckBox IsChecked="{Binding IsAutoSimulating, Mode=TwoWay}"
                                  Cursor="Hand"
                                  ToolTip="Automatically advances progress to simulate audio playback."
                                  Margin="0,0,0,12">
                            <TextBlock Text="Auto-advance simulated progress"
                                       FontSize="13"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       Margin="6,-1,0,0" />
                        </CheckBox>

                        <!-- Manual Slider and Percentage Label -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Simulated Position"
                                       FontSize="12"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SimulatedProgressPercentText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource IslandAccentBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                Value="{Binding SimulatedProgress, Mode=TwoWay}"
                                ToolTip="Simulated playback progress from 0% to 100%."
                                Margin="0,0,0,12" />

                        <!-- Simulated Track Actions -->
                        <Grid>
                            <Button Content="Reset (0%)"
                                    Width="110" Height="28"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    Foreground="{DynamicResource IslandForegroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    Click="ResetProgressButton_Click" />

                            <Button Content="Next Track (Simulated)"
                                    Width="150" Height="28"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    Foreground="{DynamicResource IslandForegroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    Click="NextTrackButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: GENERAL -->
                <TextBlock Text="GENERAL"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                           Margin="0,0,0,8" />

                <Border Background="{DynamicResource IslandCardBackgroundBrush}"
                        BorderBrush="{DynamicResource IslandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Launch At Sign-in CheckBox -->
                        <CheckBox IsChecked="{Binding LaunchAtSignIn, Mode=TwoWay}"
                                  Cursor="Hand"
                                  ToolTip="Starts Spotifly in the background when logging into Windows."
                                  Margin="0,0,0,14">
                            <TextBlock Text="Launch at Windows sign-in"
                                       FontSize="13"
                                       Foreground="{DynamicResource IslandForegroundBrush}"
                                       Margin="6,-1,0,0" />
                        </CheckBox>

                        <Separator Background="{DynamicResource IslandCardBorderBrush}" Margin="0,4,0,12" />

                        <!-- Actions: Reset to Defaults and Exit Spotifly -->
                        <Grid>
                            <Button Content="Reset to Defaults"
                                    Width="125" Height="30"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    Foreground="{DynamicResource IslandForegroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    Click="ResetButton_Click" />

                            <Button Content="Exit Spotifly"
                                    Width="110" Height="30"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand"
                                    Background="#33E22A2A"
                                    Foreground="#FF6B6B"
                                    BorderBrush="#88E22A2A"
                                    Click="ExitButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 5: ABOUT -->
                <TextBlock Text="ABOUT"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                           Margin="0,0,0,8" />

                <Border Background="{DynamicResource IslandCardBackgroundBrush}"
                        BorderBrush="{DynamicResource IslandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding AppName}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource IslandForegroundBrush}" />
                            <TextBlock Text="Windows Dynamic Island for Spotify"
                                       FontSize="11"
                                       Foreground="{DynamicResource IslandSecondaryForegroundBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding AppVersion}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource IslandAccentBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Close Dialog Button -->
                <Button Content="Close"
                        Height="34"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Background="{DynamicResource IslandButtonHoverBrush}"
                        Foreground="{DynamicResource IslandForegroundBrush}"
                        BorderBrush="{DynamicResource IslandBorderBrush}"
                        Click="CloseButton_Click" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
